+#if defined(PIOS_INCLUDE_I2C)
+/**
+ * @brief Bring up an MPU6000-family part on I2C instead of SPI.
+ *
+ * Same silicon, same registers, same configuration sequence -- only the
+ * transport differs. Useful for breakout boards that do not bring SDO/AD0
+ * out to a pin, which makes 4-wire SPI physically impossible.
+ *
+ * @param[in] i2c_id  PiOS I2C adapter id
+ * @param[in] i2c_addr 7-bit address: 0x68 with AD0 low, 0x69 with AD0 high
+ */
+int32_t PIOS_MPU6000_Init_I2C(uint32_t i2c_id, uint8_t i2c_addr, const struct pios_mpu6000_cfg *cfg)
+{
+    dev = PIOS_MPU6000_alloc(cfg);
+    if (dev == NULL) {
+        return -1;
+    }
+
+    dev->use_i2c   = true;
+    dev->i2c_id    = i2c_id;
+    dev->i2c_addr  = i2c_addr;
+    dev->spi_id    = 0;
+    dev->slave_num = 0;
+    dev->cfg = cfg;
+
+    PIOS_MPU6000_Config(cfg);
+
+    PIOS_EXTI_Init(cfg->exti_cfg);
+    return 0;
+}
+#endif /* PIOS_INCLUDE_I2C */
