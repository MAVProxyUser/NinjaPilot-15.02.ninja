+/*
+ * Parts this driver can drive.
+ *
+ * The MPU-6500 family (which includes the ICM-206xx) keeps the MPU6000's
+ * register map for everything this driver touches: the 14-byte burst from
+ * ACCEL_XOUT_H (0x3B) is the same AX/AY/AZ/TEMP/GX/GY/GZ layout, GYRO_CONFIG
+ * (0x1B) / ACCEL_CONFIG (0x1C) / CONFIG (0x1A) / SMPLRT_DIV (0x19) /
+ * INT_ENABLE (0x38) / USER_CTRL (0x6A) / PWR_MGMT_1 (0x6B) all match, and the
+ * full-scale codes give identical LSB-per-unit scaling. Only WHO_AM_I differs,
+ * so the ID gate is the only thing that has to know about them.
+ *
+ * The ICM-20602 additionally has ACCEL_CONFIG2 (0x1D) for the accel DLPF,
+ * which does not exist on the MPU6000. Its reset default (218Hz BW, 1kHz
+ * output) is what we want, so it is deliberately left alone.
+ */
+static const struct {
+    uint8_t     id;
+    const char *name;
+} pios_mpu6000_known_ids[] = {
+    { 0x68, "MPU6000/MPU6050" },
+    { 0x70, "MPU6500"         },
+    { 0x12, "ICM-20602"       },
+};
