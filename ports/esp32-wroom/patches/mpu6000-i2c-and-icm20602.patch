+/*
+ * Bounded register write.
+ *
+ * PIOS_MPU6000_Config() originally retried each write with an unbounded
+ * `PIOS_MPU6000_SetRegBounded(...);`. That is fine when the part is
+ * present, but with nothing on the bus MISO floats high, every write reports
+ * failure, and board init hangs forever before telemetry starts -- the board
+ * looks dead rather than reporting a missing IMU. Retry a bounded number of
+ * times and give up.
+ */
+#define PIOS_MPU6000_SETREG_RETRIES 10
+
+static bool PIOS_MPU6000_SetRegBounded(uint8_t reg, uint8_t data)
+{
+    for (uint8_t i = 0; i < PIOS_MPU6000_SETREG_RETRIES; i++) {
+        if (PIOS_MPU6000_SetReg(reg, data) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
