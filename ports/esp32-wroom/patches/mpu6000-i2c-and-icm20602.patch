     if (mpu6000_id < 0) {
         return -1;
     }
 
-    if (mpu6000_id != 0x68) {
-        return -2;
+    for (uint8_t i = 0; i < NELEMENTS(pios_mpu6000_known_ids); i++) {
+        if (mpu6000_id == pios_mpu6000_known_ids[i].id) {
+            return 0;
+        }
     }
 
-    return 0;
+    /* Callers get -2 and the raw id via PIOS_MPU6000_ReadID(); "no IMU" and
+     * "an IMU this driver does not recognise" are very different problems and
+     * the board file is where that distinction can actually be reported. */
+    return -2;
 }
 
