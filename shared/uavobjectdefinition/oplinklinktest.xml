<xml>
    <object name="OPLinkLinkTest" singleinstance="true" settings="false" category="System">
        <description>Round trip through an OPLink pair with no flight controller: the GCS sends a Request through the modem it is connected to, the modem at the far end of the radio answers with a Reply carrying its identity, link state and settings.</description>
        <field name="Seq" units="" type="uint16" elements="1" defaultvalue="0"/>
        <field name="Echo" units="" type="enum" elements="1" options="Request,Reply" defaultvalue="Request"/>
        <field name="DeviceID" units="hex" type="uint32" elements="1" defaultvalue="0"/>
        <field name="LinkState" units="" type="enum" elements="1" options="Disabled,Enabled,Disconnected,Connecting,Connected" defaultvalue="Disabled"/>
        <field name="RSSI" units="dBm" type="int8" elements="1" defaultvalue="-127"/>
        <field name="Coordinator" units="" type="enum" elements="1" options="FALSE,TRUE" defaultvalue="FALSE"/>
        <field name="CoordID" units="hex" type="uint32" elements="1" defaultvalue="0"/>
        <field name="MaxRFPower" units="mW" type="enum" elements="1" options="0,1.25,1.6,3.16,6.3,12.6,25,50,100" defaultvalue="0"/>
        <field name="ComSpeed" units="bps" type="enum" elements="1" options="4800,9600,19200,38400,57600,115200" defaultvalue="38400"/>
        <field name="MinChannel" units="" type="uint8" elements="1" defaultvalue="0"/>
        <field name="MaxChannel" units="" type="uint8" elements="1" defaultvalue="250"/>
        <field name="MainPort" units="function" type="enum" elements="1" options="Disabled,Telemetry,Serial,PPM,PWM" defaultvalue="Disabled"/>
        <field name="FlexiPort" units="function" type="enum" elements="1" options="Disabled,Telemetry,Serial,PPM,PWM" defaultvalue="Disabled"/>
        <field name="VCPPort" units="function" type="enum" elements="1" options="Disabled,Serial" defaultvalue="Disabled"/>
        <field name="Payload" units="" type="uint8" elements="8" defaultvalue="0"/>
        <access gcs="readwrite" flight="readwrite"/>
        <telemetrygcs acked="false" updatemode="manual" period="0"/>
        <telemetryflight acked="false" updatemode="manual" period="0"/>
        <logging updatemode="manual" period="0"/>
    </object>
</xml>
