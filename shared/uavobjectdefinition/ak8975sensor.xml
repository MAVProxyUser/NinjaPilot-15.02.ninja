<xml>
    <object name="AK8975Sensor" singleinstance="true" settings="false" category="Sensors">
        <description>The MPU-9150's own AK8975 compass, read via I2C bypass on the CAN node and shipped as vendor msg 20504. Device frame, factory-sensitivity adjusted, 3 mGa per LSB.</description>
        <field name="x" units="mGa" type="float" elements="1"/>
        <field name="y" units="mGa" type="float" elements="1"/>
        <field name="z" units="mGa" type="float" elements="1"/>
        <field name="Overflow" units="" type="enum" elements="1" options="False,True" defaultvalue="False"/>
        <access gcs="readwrite" flight="readwrite"/>
        <telemetrygcs acked="false" updatemode="manual" period="0"/>
        <telemetryflight acked="false" updatemode="periodic" period="1000"/>
        <logging updatemode="manual" period="0"/>
    </object>
</xml>
