	-$(MOVE) $(TARGET) ../../../bin/NinjaPilot\ GCS.app/Contents/Plugins/$(TARGET)
	-$(DEL_FILE) ../../../bin/NinjaPilot\ GCS.app/Contents/Plugins/$(TARGET0)
	-$(DEL_FILE) ../../../bin/NinjaPilot\ GCS.app/Contents/Plugins/$(TARGET1)
