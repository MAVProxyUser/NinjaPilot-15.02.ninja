FORCE:

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: sub-splinetest-distdir sub-splineprof-distdir FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents ../.qmake.stash ../qwtconfig.pri tests.pro $(DISTDIR)/

sub-splinetest-distdir: FORCE
	@test -d splinetest/ || mkdir -p splinetest/
	cd splinetest/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/src/libs/qwt/tests/splinetest/splinetest.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/splinetest

sub-splineprof-distdir: FORCE
	@test -d splineprof/ || mkdir -p splineprof/
	cd splineprof/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/src/libs/qwt/tests/splineprof/splineprof.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/splineprof

