qmake: FORCE
	@$(QMAKE) -o Makefile tests.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release

qmake_all: sub-splinetest-qmake_all sub-splineprof-qmake_all FORCE

make_first: sub-splinetest-make_first sub-splineprof-make_first  FORCE
all: sub-splinetest-all sub-splineprof-all  FORCE
clean: sub-splinetest-clean sub-splineprof-clean  FORCE
distclean: sub-splinetest-distclean sub-splineprof-distclean  FORCE
	-$(DEL_FILE) Makefile
install_subtargets: sub-splinetest-install_subtargets sub-splineprof-install_subtargets FORCE
uninstall_subtargets: sub-splinetest-uninstall_subtargets sub-splineprof-uninstall_subtargets FORCE

xcodeproj:
	@$(QMAKE) -spec macx-xcode "$(EXPORT__PRO_FILE_)" -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release

sub-splinetest-check:
	@test -d splinetest/ || mkdir -p splinetest/
	cd splinetest/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/src/libs/qwt/tests/splinetest/splinetest.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release ) && $(MAKE) -f Makefile check
sub-splineprof-check:
	@test -d splineprof/ || mkdir -p splineprof/
	cd splineprof/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/src/libs/qwt/tests/splineprof/splineprof.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release ) && $(MAKE) -f Makefile check
check: sub-splinetest-check sub-splineprof-check

sub-splinetest-benchmark:
	@test -d splinetest/ || mkdir -p splinetest/
	cd splinetest/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/src/libs/qwt/tests/splinetest/splinetest.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release ) && $(MAKE) -f Makefile benchmark
sub-splineprof-benchmark:
	@test -d splineprof/ || mkdir -p splineprof/
	cd splineprof/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/src/libs/qwt/tests/splineprof/splineprof.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release ) && $(MAKE) -f Makefile benchmark
