####### Build rules

../lib/qwt.framework/qwt:  $(OBJECTS) $(SUBLIBS) $(OBJCOMP)  
	@test -d ../lib/qwt.framework/ || mkdir -p ../lib/qwt.framework/
	-$(DEL_FILE) $(TARGET) $(TARGET0) $(DESTDIR)$(TARGET0)
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(LIBS) $(OBJCOMP)
	@test -d "`dirname $(DESTDIR)$(TARGETD)`" || mkdir -p "`dirname $(DESTDIR)$(TARGETD)`"
	-$(MOVE) $(TARGET) $(DESTDIR)$(TARGETD)
	@test -d "`dirname $(DESTDIR)$(TARGET0)`" || mkdir -p "`dirname $(DESTDIR)$(TARGET0)`"
	-ln -s Versions/Current/$(TARGET) $(DESTDIR)$(TARGET0)
	



staticlib: ../lib/libqwt.a

../lib/libqwt.a:  $(OBJECTS) $(OBJCOMP) 
	-$(DEL_FILE) $(TARGETA) 
	$(AR) $(TARGETA) $(OBJECTS)
	$(RANLIB) $(TARGETA)

