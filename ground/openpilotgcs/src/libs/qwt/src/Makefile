####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/local/qwt-6.3.0/lib || mkdir -p $(INSTALL_ROOT)/usr/local/qwt-6.3.0/lib
	$(DEL_FILE) -r $(INSTALL_ROOT)/usr/local/qwt-6.3.0/lib/qwt.framework
	
	$(QINSTALL) ../lib/qwt.framework $(INSTALL_ROOT)/usr/local/qwt-6.3.0/lib/qwt.framework
	-$(STRIP) -S -x $(INSTALL_ROOT)/usr/local/qwt-6.3.0/lib/qwt.framework/Versions/6/$(TARGET)
	@test -d $(INSTALL_ROOT)/usr/local/qwt-6.3.0/lib/pkgconfig || mkdir -p $(INSTALL_ROOT)/usr/local/qwt-6.3.0/lib/pkgconfig
	$(INSTALL_FILE) ../lib/pkgconfig/Qt5Qwt6.pc $(INSTALL_ROOT)/usr/local/qwt-6.3.0/lib/pkgconfig/Qt5Qwt6.pc

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/local/qwt-6.3.0/lib/qwt.framework 
	 -$(DEL_FILE) $(INSTALL_ROOT)/usr/local/qwt-6.3.0/lib/pkgconfig/Qt5Qwt6.pc
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/local/qwt-6.3.0/lib/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

