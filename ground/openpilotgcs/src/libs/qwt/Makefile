	@test -d $(INSTALL_ROOT)/usr/local/qwt-6.3.0/features || mkdir -p $(INSTALL_ROOT)/usr/local/qwt-6.3.0/features
	$(QINSTALL) /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/src/libs/qwt/qwtconfig.pri $(INSTALL_ROOT)/usr/local/qwt-6.3.0/features/qwtconfig.pri
	$(QINSTALL) /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/src/libs/qwt/qwtfunctions.pri $(INSTALL_ROOT)/usr/local/qwt-6.3.0/features/qwtfunctions.pri
	$(QINSTALL) /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/src/libs/qwt/qwt.prf $(INSTALL_ROOT)/usr/local/qwt-6.3.0/features/qwt.prf

uninstall_qwtspec: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/local/qwt-6.3.0/features/qwt.prf
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/local/qwt-6.3.0/features/qwtfunctions.pri
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/local/qwt-6.3.0/features/qwtconfig.pri
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/local/qwt-6.3.0/features/ 


