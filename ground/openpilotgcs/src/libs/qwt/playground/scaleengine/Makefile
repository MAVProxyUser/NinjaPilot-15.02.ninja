../bin/scaleengine.app/Contents/PkgInfo: 
	@test -d ../bin/scaleengine.app/Contents || mkdir -p ../bin/scaleengine.app/Contents
	@$(DEL_FILE) ../bin/scaleengine.app/Contents/PkgInfo
	@echo "APPL????" > ../bin/scaleengine.app/Contents/PkgInfo
../bin/scaleengine.app/Contents/Resources/empty.lproj: 
	@test -d ../bin/scaleengine.app/Contents/Resources || mkdir -p ../bin/scaleengine.app/Contents/Resources
	@touch ../bin/scaleengine.app/Contents/Resources/empty.lproj
	
../bin/scaleengine.app/Contents/Info.plist: 
	@test -d ../bin/scaleengine.app/Contents || mkdir -p ../bin/scaleengine.app/Contents
	@$(DEL_FILE) ../bin/scaleengine.app/Contents/Info.plist
	@sed -e "s,@SHORT_VERSION@,6.3,g" -e "s,\$${QMAKE_SHORT_VERSION},6.3,g" -e "s,@FULL_VERSION@,6.3.0,g" -e "s,\$${QMAKE_FULL_VERSION},6.3.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.scaleengine,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.scaleengine,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},10.13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,scaleengine,g" -e "s,@LIBRARY@,scaleengine,g" -e "s,\$${EXECUTABLE_NAME},scaleengine,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang/Info.plist.app >../bin/scaleengine.app/Contents/Info.plist

