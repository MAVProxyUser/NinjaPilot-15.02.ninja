           <item><widget class="QGroupBox" name="grpMainOut"><property name="title"><string>MAIN OUT 1-8  (servo header)</string></property><layout class="QVBoxLayout"><item><widget class="QLabel" name="grpMainOutLbl"><property name="text"><string>IO co-processor PWM outputs. DroneCAN ESCs are on CAN 2 instead. POWER 1 / POWER 2: power modules.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item></layout></widget></item>
