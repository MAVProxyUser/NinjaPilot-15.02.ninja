     <widget class="QWidget" name="scrollAreaWidgetContents">
      <layout class="QVBoxLayout" name="contentsLayout">
       <item><widget class="QLabel" name="lblTitle"><property name="font"><font><bold>true</bold></font></property><property name="text"><string>CubePilot Cube Purple on the Mini Carrier Board: the carrier's connectors, as the firmware uses them. Port changes need a reboot.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
       <item>
        <layout class="QGridLayout" name="boardGrid">
         <item row="0" column="1">
          <layout class="QHBoxLayout" name="topRow">
           <item><widget class="QGroupBox" name="grpTelem1"><property name="title"><string>TELEM 1  (Serial 1, USART2)</string></property><layout class="QVBoxLayout"><item><widget class="QComboBox" name="cbTelem1"><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item><layout class="QHBoxLayout"><item><widget class="QLabel" name="lblTelem1Speed"><property name="text"><string>Speed</string></property></widget></item><item><widget class="QComboBox" name="cbTelem1TelemSpeed"><property name="minimumSize"><size><width>110</width><height>0</height></size></property></widget></item><item><widget class="QComboBox" name="cbTelem1ComSpeed"><property name="minimumSize"><size><width>110</width><height>0</height></size></property></widget></item></layout></item></layout></widget></item>
           <item><widget class="QGroupBox" name="grpTelem2"><property name="title"><string>TELEM 2  (Serial 2, USART3)</string></property><layout class="QVBoxLayout"><item><widget class="QComboBox" name="cbTelem2"><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item><layout class="QHBoxLayout"><item><widget class="QLabel" name="lblTelem2Speed"><property name="text"><string>Speed</string></property></widget></item><item><widget class="QComboBox" name="cbTelem2TelemSpeed"><property name="minimumSize"><size><width>110</width><height>0</height></size></property></widget></item><item><widget class="QComboBox" name="cbTelem2ComSpeed"><property name="minimumSize"><size><width>110</width><height>0</height></size></property></widget></item></layout></item><item><widget class="QLabel" name="lblTelem2Note"><property name="font"><font><italic>true</italic></font></property><property name="text"><string>DSM: a Spektrum satellite on TELEM2 (pin 1 5V, pin 3 RX, pin 6 GND), decoded by the flight controller.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item></layout></widget></item>
          </layout>
         </item>
         <item row="1" column="0">
          <layout class="QVBoxLayout" name="leftColumn">
           <item><widget class="QGroupBox" name="grpGPS1"><property name="title"><string>GPS 1  (Serial 3, UART4, 8-pin)</string></property><layout class="QVBoxLayout"><item><widget class="QComboBox" name="cbGPS1"><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item><layout class="QHBoxLayout"><item><widget class="QLabel" name="lblGPS1Speed"><property name="text"><string>Speed</string></property></widget></item><item><widget class="QComboBox" name="cbGPS1TelemSpeed"><property name="minimumSize"><size><width>110</width><height>0</height></size></property></widget></item><item><widget class="QComboBox" name="cbGPS1GPSSpeed"><property name="minimumSize"><size><width>110</width><height>0</height></size></property></widget></item><item><widget class="QComboBox" name="cbGPS1ComSpeed"><property name="minimumSize"><size><width>110</width><height>0</height></size></property></widget></item></layout></item><item><layout class="QHBoxLayout"><item><widget class="QLabel" name="lblGPS1Protocol"><property name="text"><string>Protocol</string></property></widget></item><item><widget class="QComboBox" name="cbGPS1GPSProtocol"><property name="minimumSize"><size><width>110</width><height>0</height></size></property></widget></item></layout></item></layout></widget></item>
           <item><widget class="QGroupBox" name="grpCAN2"><property name="title"><string>CAN 2  (4-pin)</string></property><layout class="QVBoxLayout"><item><widget class="QLabel" name="grpCAN2Lbl"><property name="text"><string>DroneCAN bus: the ESCs and other CAN nodes. No setting; the DroneCAN module owns it.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item></layout></widget></item>
