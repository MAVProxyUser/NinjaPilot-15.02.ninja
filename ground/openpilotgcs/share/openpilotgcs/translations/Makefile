phony_target2.app/Contents/PkgInfo: 
	@test -d phony_target2.app/Contents || mkdir -p phony_target2.app/Contents
	@$(DEL_FILE) phony_target2.app/Contents/PkgInfo
	@echo "APPL????" > phony_target2.app/Contents/PkgInfo
phony_target2.app/Contents/Resources/empty.lproj: 
	@test -d phony_target2.app/Contents/Resources || mkdir -p phony_target2.app/Contents/Resources
	@touch phony_target2.app/Contents/Resources/empty.lproj
	
phony_target2.app/Contents/Info.plist: 
	@test -d phony_target2.app/Contents || mkdir -p phony_target2.app/Contents
	@$(DEL_FILE) phony_target2.app/Contents/Info.plist
	@sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.phony-target2,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.phony-target2,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},10.13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,phony_target2,g" -e "s,@LIBRARY@,phony_target2,g" -e "s,\$${EXECUTABLE_NAME},phony_target2,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang/Info.plist.app >phony_target2.app/Contents/Info.plist

all: Makefile \
		phony_target2.app/Contents/PkgInfo \
