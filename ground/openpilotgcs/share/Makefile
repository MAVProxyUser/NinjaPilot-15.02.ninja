share.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile share.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release

qmake_all: sub-openpilotgcs-translations-qmake_all sub-copydata-pro-qmake_all FORCE

make_first: sub-openpilotgcs-translations-make_first sub-copydata-pro-make_first  FORCE
all: sub-openpilotgcs-translations-all sub-copydata-pro-all  FORCE
clean: sub-openpilotgcs-translations-clean sub-copydata-pro-clean  FORCE
distclean: sub-openpilotgcs-translations-distclean sub-copydata-pro-distclean  FORCE
	-$(DEL_FILE) Makefile
install_subtargets: sub-openpilotgcs-translations-install_subtargets sub-copydata-pro-install_subtargets FORCE
uninstall_subtargets: sub-openpilotgcs-translations-uninstall_subtargets sub-copydata-pro-uninstall_subtargets FORCE

xcodeproj:
	@$(QMAKE) -spec macx-xcode "$(EXPORT__PRO_FILE_)" -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release

sub-openpilotgcs-translations-check:
	@test -d openpilotgcs/translations/ || mkdir -p openpilotgcs/translations/
	cd openpilotgcs/translations/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/share/openpilotgcs/translations/translations.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release ) && $(MAKE) -f Makefile check
sub-copydata-pro-check:
	( test -e Makefile.copydata || $(QMAKE) -o Makefile.copydata /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/share/copydata.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release ) && $(MAKE) -f Makefile.copydata check
check: sub-openpilotgcs-translations-check sub-copydata-pro-check

sub-openpilotgcs-translations-benchmark:
	@test -d openpilotgcs/translations/ || mkdir -p openpilotgcs/translations/
	cd openpilotgcs/translations/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/share/openpilotgcs/translations/translations.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release ) && $(MAKE) -f Makefile benchmark
sub-copydata-pro-benchmark:
	( test -e Makefile.copydata || $(QMAKE) -o Makefile.copydata /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/share/copydata.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release ) && $(MAKE) -f Makefile.copydata benchmark
benchmark: sub-openpilotgcs-translations-benchmark sub-copydata-pro-benchmark
install:install_subtargets  FORCE

uninstall: uninstall_subtargets FORCE

FORCE:

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: sub-openpilotgcs-translations-distdir sub-copydata-pro-distdir FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents ../../.qmake.stash share.pro $(DISTDIR)/

sub-openpilotgcs-translations-distdir: FORCE
	@test -d openpilotgcs/translations/ || mkdir -p openpilotgcs/translations/
	cd openpilotgcs/translations/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/share/openpilotgcs/translations/translations.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/openpilotgcs/translations

sub-copydata-pro-distdir: FORCE
	( test -e Makefile.copydata || $(QMAKE) -o Makefile.copydata /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/share/copydata.pro -spec /opt/homebrew/Cellar/qt@5/5.15.16_2/mkspecs/macx-clang CONFIG+=release ) && $(MAKE) -e -f Makefile.copydata distdir DISTDIR=$(DISTDIR)/

