qmake: FORCE
	@$(QMAKE) -o Makefile ground.pro

qmake_all: sub-openpilotgcs-qmake_all sub-uavobject-synthetics-qmake_all sub-uavobjgenerator-qmake_all FORCE

make_first: sub-openpilotgcs-make_first sub-uavobject-synthetics-make_first sub-uavobjgenerator-make_first  FORCE
all: sub-openpilotgcs-all sub-uavobject-synthetics-all sub-uavobjgenerator-all  FORCE
clean: sub-openpilotgcs-clean sub-uavobject-synthetics-clean sub-uavobjgenerator-clean  FORCE
distclean: sub-openpilotgcs-distclean sub-uavobject-synthetics-distclean sub-uavobjgenerator-distclean  FORCE
	-$(DEL_FILE) Makefile
install_subtargets: sub-openpilotgcs-install_subtargets sub-uavobject-synthetics-install_subtargets sub-uavobjgenerator-install_subtargets FORCE
uninstall_subtargets: sub-openpilotgcs-uninstall_subtargets sub-uavobject-synthetics-uninstall_subtargets sub-uavobjgenerator-uninstall_subtargets FORCE

xcodeproj:
	@$(QMAKE) -spec macx-xcode "$(EXPORT__PRO_FILE_)"

sub-openpilotgcs-check: sub-uavobject-synthetics-check
	@test -d openpilotgcs/ || mkdir -p openpilotgcs/
	cd openpilotgcs/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/openpilotgcs/openpilotgcs.pro ) && $(MAKE) -f Makefile check
