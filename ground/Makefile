	@test -d uavobject-synthetics/ || mkdir -p uavobject-synthetics/
	cd uavobject-synthetics/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/uavobject-synthetics/uavobject-synthetics.pro ) && $(MAKE) -f Makefile check
