	@test -d uavobjgenerator/ || mkdir -p uavobjgenerator/
	cd uavobjgenerator/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/kfinisterre/NinjaPilot-15.02.ninja/ground/uavobjgenerator/uavobjgenerator.pro ) && $(MAKE) -f Makefile check
check: sub-openpilotgcs-check sub-uavobject-synthetics-check sub-uavobjgenerator-check

