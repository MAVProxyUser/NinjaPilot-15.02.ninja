# Grass ring around the farm's measured GROUND extent.
# Sits at z=-3.05 (below the lowest perimeter terrain) and overlaps
# 6m inward so the farm's own sloping skirt hides the junction.
# UVs are world-position/8 -> seamless tiling across all quads.
mtllib grass_ring.mtl
usemtl grass
v -1000.000 -1000.000 0.000
v 1000.000 -1000.000 0.000
v 1000.000 -67.700 0.000
v -1000.000 -67.700 0.000
v -1000.000 65.100 0.000
v 1000.000 65.100 0.000
v 1000.000 1000.000 0.000
v -1000.000 1000.000 0.000
v -1000.000 -67.700 0.000
v -55.600 -67.700 0.000
v -55.600 65.100 0.000
v -1000.000 65.100 0.000
v 52.400 -67.700 0.000
v 1000.000 -67.700 0.000
v 1000.000 65.100 0.000
v 52.400 65.100 0.000
vt -125.0000 -125.0000
vt 125.0000 -125.0000
vt 125.0000 -8.4625
vt -125.0000 -8.4625
vt -125.0000 8.1375
vt 125.0000 8.1375
vt 125.0000 125.0000
vt -125.0000 125.0000
vt -125.0000 -8.4625
vt -6.9500 -8.4625
vt -6.9500 8.1375
vt -125.0000 8.1375
vt 6.5500 -8.4625
vt 125.0000 -8.4625
vt 125.0000 8.1375
vt 6.5500 8.1375
vn 0 0 1
f 1/1/1 2/2/1 3/3/1 4/4/1
f 5/5/1 6/6/1 7/7/1 8/8/1
f 9/9/1 10/10/1 11/11/1 12/12/1
f 13/13/1 14/14/1 15/15/1 16/16/1
