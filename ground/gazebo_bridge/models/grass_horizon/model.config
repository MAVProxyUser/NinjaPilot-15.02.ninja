<?xml version="1.0"?>
<model>
  <name>grass_horizon</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    Textured grass extending to the horizon around the agriculture_world
    farm. The grass texture is cropped from the farm's own baked atlas
    (AgriBakeLarge.jpg) and mirror-tiled to be seamless, so the horizon
    matches the centrepiece rather than being a flat colour patch.
    Visual only: no collision, no physics.
  </description>
</model>
