<?xml version="1.0"?>
<model>
  <name>agriculture_world</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Clearpath Robotics</name>
  </author>

  <description>
    Outdoor agricultural scene from Clearpath Robotics' cpr_gazebo
    (cpr_agriculture_gazebo, noetic-devel), ported from Gazebo Classic to
    gz-sim. The scene is a single baked COLLADA mesh - there were no Classic
    plugins to port, so the geometry and textures transfer unchanged. Only
    the ROS/URDF spawn wrapper was replaced with this SDF model.

    Upstream: https://github.com/clearpathrobotics/cpr_gazebo
    License: see cpr_agriculture_gazebo/docs/LICENSE.txt upstream (BSD).
  </description>
</model>
