<?xml version="1.0" ?>
<!--
  Multicopter motor plugin demo

  Send commands to go straight up:

      gz topic -t /X3/gazebo/command/motor_speed --msgtype gz.msgs.Actuators -p 'velocity:[700, 700, 700, 700]'

  And to turn off propellers:

      gz topic -t /X3/gazebo/command/motor_speed --msgtype gz.msgs.Actuators -p 'velocity:[0, 0, 0, 0]'

-->
<sdf version="1.6">
  <world name="quadcopter">
    <!-- Matches gazebo_bridge.py's HOME_LATITUDE/HOME_LONGITUDE/HOME_ALTITUDE
         so the navsat sensor's lat/lon/alt output lines up with the
         HomeLocation UAVObject the bridge sends over UAVTalk - without
         this, world-origin (0,0,0) would report as (0,0,0) lat/lon
         instead of this reference point. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.7749</latitude_deg>
      <longitude_deg>-122.4194</longitude_deg>
      <elevation>30.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <!-- Matches gazebo_bridge.py's/board_orientation_viz.py's HOMELOCATION_DEFAULTS
         Be=[26000,400,40000] nT in NED (North,East,Down) - converted to
         Tesla in this world's ENU frame (East,North,Up) so the real
         gz-sim-magnetometer-system plugin's body-frame reading is derived
         from the vehicle's own authoritative orientation, not a Python-side
         quaternion rotation of a separately-tracked reference (see
         CLAUDE.md/session notes: a mismatch there was slowly driving
         filtercf.c's mag_err/gyroBias[2] and causing spurious yaw torque). -->
    <magnetic_field>0.0000004 0.000026 -0.00004</magnetic_field>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Contact sensing must be a WORLD system, not a model plugin. Declared
         on the model it loads silently and publishes nothing, which is how
         the intercept test ended up detecting collisions by sampling the
         distance between two objects at 20Hz - and aliasing straight over
         them. Closing at ~2-3 m/s, consecutive samples are 10-15cm apart,
         so a real strike (IMU peaked at 4.0g) can be recorded as a 0.58m
         miss. This gives the physics engine's own verdict at full rate. -->
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>
    <plugin
      filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
    </plugin>
    <plugin
      filename="gz-sim-air-pressure-system"
      name="gz::sim::systems::AirPressure">
    </plugin>
    <!-- Wind. Driven from the GUI's wind sliders, which publish
         gz.msgs.Wind on /world/quadcopter/wind/. The sin/noise shaping from
         gz's own wind demo is deliberately omitted: a test needs the wind it
         asked for, repeatably, not a randomly gusting one. Links must also
         declare <enable_wind> for the force to be applied to them. -->
    <plugin
      filename="gz-sim-wind-effects-system"
      name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1</force_approximation_scaling_factor>
    </plugin>



    <!-- Gazebo's DEFAULT gui.config verbatim, plus our Wind panel.
         Declaring <gui> REPLACES the defaults rather than adding to them:
         a hand-written short list silently dropped MarkerManager and took
         the flight trails with it. -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>3D View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>

  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light>
  <background_color>0.8 0.8 0.8</background_color>
  <!-- WHOLE-FARM OVERVIEW, barn toward the top of the screen.
       ENU: x=East, y=North, z=Up. The action spans roughly N/E -34 (target
       spawn) to +20 (the barn), so the camera sits ~75m SOUTH and 60m up,
       yawed +90deg to look NORTH - which puts the barn at the top of the
       frame and the target's inbound run coming toward the viewer. Pitch
       0.60 rad is atan(55/80), i.e. aimed at the middle of that span.
       The previous -6 0 6 was a close-in pad view: fine for takeoff, useless
       for watching a 50m engagement. -->
  <camera_pose>-5 -75 60 0 0.60 1.5708</camera_pose>
</plugin>

<!-- Plugins that add functionality to the scene -->
<plugin filename="EntityContextMenuPlugin" name="Entity context menu">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>
<plugin filename="CameraTracking" name="Camera Tracking">
      <!-- Chase cam settings are kept, but following is NOT armed at startup.
           gz-rendering's camera stores a single followOffset and eases the
           camera toward target+offset every frame (BaseCamera::SetFollowOffset
           / followPGain), so while follow is active it rewrites the camera
           pose continuously - a manual scroll-wheel zoom is undone on the
           next frame, which is the "snaps back to the original view" effect.
           There is no stock setting that keeps continuous follow AND honours
           manual zoom; the two are the same control.

           Note the follow is armed by the BRIDGE, not by this file - it calls
           the /gui/follow service on startup (gazebo_bridge.py, gui_follow()).
           Set NINJAPILOT_GUI_FOLLOW=0 to leave the camera free, or turn the
           chase cam on by hand with right-click on the vehicle -> Follow. The
           offset and gain below are what either path uses. -->
      <follow_offset>-14 -14 9</follow_offset>
      <follow_pgain>0.008</follow_pgain>
      <follow_worldframe>true</follow_worldframe>
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>
<plugin filename="MarkerManager" name="Marker manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>
<plugin filename="SelectEntities" name="Select Entities">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="Spawn" name="Spawn Entities">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
