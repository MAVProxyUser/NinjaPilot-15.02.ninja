<!-- Inspector -->

<!-- Entity tree -->
    <!-- Wind panel (gui_plugins/WindControl). FLOATING and small: docked,
         it expands to fill the window and hides the 3D view. -->
    <plugin filename="WindControl" name="Wind">
      <gz-gui>
        <title>Wind</title>
        <property type="bool" key="showTitleBar">true</property>
        <property type="bool" key="resizable">true</property>
        <property type="double" key="width">330</property>
        <property type="double" key="height">210</property>
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="right" target="right"/>
          <line own="top" target="top"/>
        </anchors>
      </gz-gui>
      <topic>/world/quadcopter/wind</topic>
    </plugin>

    <!-- GPS noise panel, anchored LEFT of the wind panel. Publishes the
         requested sigmas on /ninjapilot/gps_noise; the bridge applies them
         when it synthesises GPSPositionSensor/GPSVelocitySensor, because
         that is where the flight controller's GPS actually comes from. -->
    <plugin filename="GpsNoise" name="GPS noise">
      <gz-gui>
        <title>GPS noise</title>
        <property type="bool" key="showTitleBar">true</property>
        <property type="bool" key="resizable">true</property>
        <property type="double" key="width">330</property>
        <property type="double" key="height">210</property>
        <property type="string" key="state">floating</property>
        <anchors target="Wind">
          <line own="right" target="left"/>
          <line own="top" target="top"/>
        </anchors>
      </gz-gui>
      <topic>/ninjapilot/gps_noise</topic>
    </plugin>

    <!-- ============ FPV CAMERA VIEWS ==============================
         The three airframe cameras, stacked in the BOTTOM-RIGHT corner,
         bottom to top: Down, FPV 45deg, Up.

         TWO RULES, both learned by getting them wrong:

         1. <anchors target="X"> resolves against a panel whose plugin
            name="X" AND <title>X</title> MATCH. With name="cam_down" but
            title "Down (VPS)", the target never resolved and the panels
            floated wherever Qt put them. The stock Wind/GPS panels work
            precisely because their name and title are identical - copy
            that pattern, and keep the two in step when renaming.

         2. Declaration order is load-bearing: a target must already be
            declared when referenced, so the bottom panel comes first and
            each one above follows. Reordering the stack means editing both
            the order AND the anchor targets.

         These use our own CameraView plugin, not gz-gui's ImageDisplay.
         ImageDisplay renders a permanent "Subscribed to: <topic>" banner
         whose string is compiled into libImageDisplay.dylib's QML resource
         - there is no config key to hide it, and topic_picker only swaps it
         for a topic combo box, which is just different chrome. On a 300x225
         panel that banner takes a third of the view, three times over.
         CameraView draws the image and nothing else. Build it with the
         wind/GPS panels: gui_plugins/WindControl.

         The cameras DO render. An earlier note here claimed they were
         blank on macOS - that was measured with the server running ALONE.
         `gz sim -s` only renders once a GUI client has brought up a
         context; with both up, frames carry real scene content. -->

    <plugin filename="CameraView" name="Down">
      <gz-gui>
        <title>Down</title>
        <property type="bool" key="showTitleBar">true</property>
        <property type="bool" key="resizable">true</property>
        <property type="double" key="width">300</property>
        <property type="double" key="height">225</property>
        <property type="string" key="state">floating</property>
        <anchors target="3D View">
          <line own="bottom" target="bottom"/>
          <line own="right" target="right"/>
        </anchors>
      </gz-gui>
      <topic>/X3/cam_down/image</topic>
    </plugin>

    <plugin filename="CameraView" name="FPV 45deg">
      <gz-gui>
        <title>FPV 45deg</title>
        <property type="bool" key="showTitleBar">true</property>
        <property type="bool" key="resizable">true</property>
        <property type="double" key="width">300</property>
        <property type="double" key="height">225</property>
        <property type="string" key="state">floating</property>
        <anchors target="Down">
          <line own="bottom" target="top"/>
          <line own="right" target="right"/>
        </anchors>
      </gz-gui>
      <topic>/X3/cam_fpv45/image</topic>
    </plugin>

    <plugin filename="CameraView" name="Up">
      <gz-gui>
        <title>Up</title>
        <property type="bool" key="showTitleBar">true</property>
        <property type="bool" key="resizable">true</property>
        <property type="double" key="width">300</property>
        <property type="double" key="height">225</property>
        <property type="string" key="state">floating</property>
        <anchors target="FPV 45deg">
          <line own="bottom" target="top"/>
          <line own="right" target="right"/>
        </anchors>
      </gz-gui>
      <topic>/X3/cam_up/image</topic>
    </plugin>

    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <!-- 0 0 10 -> 0 0 900. For a DIRECTIONAL light the position is
           physically meaningless: only <direction> affects illumination,
           because the rays are parallel and infinitely distant by
           definition. The pose only decides where the GUI draws the light's
           gizmo - the small green marker that was hovering 10m over the
           pad, in the middle of every view. gz-sim's GzSceneManager creates
           that visual for every light ENTITY and there is no SDF switch to
           suppress it, so parking the light at 900m puts the gizmo out of
           frame while the lighting, shadows and every camera image stay
           bit-identical. Do NOT copy this to a point or spot light, where
           position is real. -->
      <pose>0 0 900 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Scene as the CAMERA SENSORS see it. The <scene> element near the
         top of this file belongs to the GUI's MinimalScene plugin and
         styles only the interactive 3D view; sensor rendering never reads
         it, which is why camera frames were a flat grey field while the GUI
         looked fine.

         <sky> is gz-sim's built-in procedural sky - a skybox and a sun
         disc, drawn once per frame at effectively no cost (it is
         background geometry with no lighting or physics contribution). It
         replaces the uniform background colour that filled most of any
         upward-looking frame. -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.55 0.72 0.92 1</background>
      <shadows>true</shadows>
      <!-- NO <sky> HERE, deliberately. gz-sim's procedural sky brings its own
           sun, and this world already declares a directional light named
           "sun" - with both present the sky's sun animates and every shadow
           in the scene sweeps around the property as it moves. The blue
           <background> gives camera frames a sky-coloured field (the actual
           complaint that started this) without a second light source. -->
    </scene>

    <!-- Grass to the horizon, so the farm reads as the centrepiece of a
         landscape instead of a mesh floating in the void.

         It is a RING, not a plane under the farm: four quads running from
         the farm's measured XY boundary (X -61.6..58.4, Y -73.7..86.3, from
         the COLLADA vertices with node transforms and the model pose
         applied) out to +/-1km. Because it never overlaps the farm mesh it
         can sit at ground level. The first attempt was a single large plane
         UNDERNEATH the farm, which punched up through the scene's own
         textured grass wherever the terrain dips - the farm's Z range is
         -5.09..13.09, so "just below the field" and "below the whole mesh"
         are 5m apart and there is no depth that works for both.

         The texture is cropped from the farm's OWN baked atlas and
         mirror-tiled to be seamless, so the horizon matches the centrepiece.
         UVs follow world position (repeat every 8m), which also means no
         seam between the four quads.

         Cost: 4 quads, one 512x512 texture, no collision, no physics, no
         shadow casting. -->
    <include>
      <uri>model://grass_horizon</uri>
    </include>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <!-- Collision only, no visual. The farm mesh supplies the ground the
             eye sees, and its field surface is offset to sit at z=0; a grey
             100x100 plane drawn at the same height would z-fight with it and
             hide the scene. The plane is KEPT for collision so takeoff and
             landing still happen against a guaranteed-flat, guaranteed-level
             floor rather than against triangle edges - physics behaviour is
             unchanged from every run before this world swap. -->
      </link>
    </model>


    <!-- ================= SCENERY =================
         Clearpath Robotics' agricultural world (cpr_agriculture_gazebo),
         ported from Gazebo Classic. It replaced a handful of hand-built
         primitives (three cone-trees, a box hangar, a tower, a windsock)
         that read as placeholders from the air.

         The port was cheap because the upstream scene is ONE baked COLLADA
         mesh with no Classic plugins attached - see
         models/agriculture_world/model.config. The model is offset so its
         open field, not its farmyard, sits under the mission envelope; the
         reasoning is in models/agriculture_world/model.sdf.

         Physics, wind, GPS noise, the GUI panels and the vehicle model are
         all untouched by this swap. -->
    <include>
      <uri>model://agriculture_world</uri>
    </include>

    <include>
      <uri>
        model://x3_ninjapilot
      </uri>
      <!-- Spawn facing TRUE NORTH (world is ENU: +Y = north, so ENU yaw
           +90deg points body-forward at +Y). Without this the model's
           zero-rotation spawn faces +X = EAST, and the bridge's
           measure-Be-at-spawn convention then defines yaw=0 as east while
           the GPS/NED frame uses true north - a standing ~90deg yaw frame
           error, invisible to attitude leveling and baro-hold but fatal
           to PathFollower (every NED correction rotated ~90deg before
           becoming roll/pitch = lateral spiral divergence, observed
           across three PositionHold gain sets). Facing north makes
           body-frame-at-spawn genuinely equal NED, so the measured-Be
           yaw reference and the GPS frame agree by construction. -->
      <pose>0 0 0.05 0 0 1.5707963</pose>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_0_joint</jointName>
        <linkName>X3/rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>0</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
