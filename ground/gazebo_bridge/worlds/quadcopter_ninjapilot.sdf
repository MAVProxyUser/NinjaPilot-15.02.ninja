<?xml version="1.0" ?>
<!--
  Multicopter motor plugin demo

  Send commands to go straight up:

      gz topic -t /X3/gazebo/command/motor_speed --msgtype gz.msgs.Actuators -p 'velocity:[700, 700, 700, 700]'

  And to turn off propellers:

      gz topic -t /X3/gazebo/command/motor_speed --msgtype gz.msgs.Actuators -p 'velocity:[0, 0, 0, 0]'

-->
<sdf version="1.6">
  <world name="quadcopter">
    <!-- Matches gazebo_bridge.py's HOME_LATITUDE/HOME_LONGITUDE/HOME_ALTITUDE
         so the navsat sensor's lat/lon/alt output lines up with the
         HomeLocation UAVObject the bridge sends over UAVTalk - without
         this, world-origin (0,0,0) would report as (0,0,0) lat/lon
         instead of this reference point. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.7749</latitude_deg>
      <longitude_deg>-122.4194</longitude_deg>
      <elevation>30.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <!-- Matches gazebo_bridge.py's/board_orientation_viz.py's HOMELOCATION_DEFAULTS
         Be=[26000,400,40000] nT in NED (North,East,Down) - converted to
         Tesla in this world's ENU frame (East,North,Up) so the real
         gz-sim-magnetometer-system plugin's body-frame reading is derived
         from the vehicle's own authoritative orientation, not a Python-side
         quaternion rotation of a separately-tracked reference (see
         CLAUDE.md/session notes: a mismatch there was slowly driving
         filtercf.c's mag_err/gyroBias[2] and causing spurious yaw torque). -->
    <magnetic_field>0.0000004 0.000026 -0.00004</magnetic_field>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>
    <plugin
      filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
    </plugin>
    <plugin
      filename="gz-sim-air-pressure-system"
      name="gz::sim::systems::AirPressure">
    </plugin>
    <!-- Wind. Driven from the GUI's wind sliders, which publish
         gz.msgs.Wind on /world/quadcopter/wind/. The sin/noise shaping from
         gz's own wind demo is deliberately omitted: a test needs the wind it
         asked for, repeatably, not a randomly gusting one. Links must also
         declare <enable_wind> for the force to be applied to them. -->
    <plugin
      filename="gz-sim-wind-effects-system"
      name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>1</force_approximation_scaling_factor>
    </plugin>



    <gui fullscreen="0">
      <!-- Wind panel: two sliders (speed in mph, direction the wind blows
           FROM) that publish gz.msgs.Wind for the WindEffects system. The
           stock "Publisher" panel can do this too, but only by hand-writing
           a protobuf message and doing the ENU conversion in your head -
           this does the conversion. Source in gui_plugins/WindControl. -->
      <plugin filename="WindControl" name="Wind">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <topic>/world/quadcopter/wind</topic>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <!-- ================= SCENERY =================
         Placed OUTSIDE the mission envelope (star radius 6m, rings at
         8/18/28m) so they give the eye something to judge motion and
         altitude against without becoming obstacles. -->

    <model name="tree_1">
      <static>true</static>
      <pose>14 9 0 0 0 0.4</pose>
      <link name="trunk">
        <pose>0 0 1.6 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.28</radius><length>3.2</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.28</radius><length>3.2</length></cylinder></geometry>
          <material><ambient>0.30 0.20 0.11 1</ambient><diffuse>0.36 0.24 0.13 1</diffuse></material>
        </visual>
      </link>
      <link name="canopy">
        <pose>0 0 4.3 0 0 0</pose>
        <collision name="c"><geometry><sphere><radius>2.1</radius></sphere></geometry></collision>
        <visual name="v">
          <geometry><sphere><radius>2.1</radius></sphere></geometry>
          <material><ambient>0.10 0.32 0.10 1</ambient><diffuse>0.14 0.44 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_2">
      <static>true</static>
      <pose>-16 -11 0 0 0 1.1</pose>
      <link name="trunk">
        <pose>0 0 2.1 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.34</radius><length>4.2</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.34</radius><length>4.2</length></cylinder></geometry>
          <material><ambient>0.28 0.18 0.10 1</ambient><diffuse>0.34 0.22 0.12 1</diffuse></material>
        </visual>
      </link>
      <link name="canopy">
        <pose>0 0 5.6 0 0 0</pose>
        <collision name="c"><geometry><sphere><radius>2.8</radius></sphere></geometry></collision>
        <visual name="v">
          <geometry><sphere><radius>2.8</radius></sphere></geometry>
          <material><ambient>0.09 0.28 0.09 1</ambient><diffuse>0.12 0.38 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_3">
      <static>true</static>
      <pose>-13 15 0 0 0 2.2</pose>
      <link name="trunk">
        <pose>0 0 1.3 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.22</radius><length>2.6</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.22</radius><length>2.6</length></cylinder></geometry>
          <material><ambient>0.30 0.20 0.11 1</ambient><diffuse>0.36 0.24 0.13 1</diffuse></material>
        </visual>
      </link>
      <link name="canopy">
        <pose>0 0 3.6 0 0 0</pose>
        <collision name="c"><geometry><sphere><radius>1.7</radius></sphere></geometry></collision>
        <visual name="v">
          <geometry><sphere><radius>1.7</radius></sphere></geometry>
          <material><ambient>0.11 0.34 0.11 1</ambient><diffuse>0.15 0.46 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A hangar-ish structure: gives a hard vertical scale reference and
         a roofline to judge the 8m ring against. -->
    <model name="hangar">
      <static>true</static>
      <pose>18 -14 0 0 0 -0.35</pose>
      <link name="walls">
        <pose>0 0 2.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>10 7 5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>10 7 5</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.72 0.72 0.75 1</diffuse></material>
        </visual>
      </link>
      <link name="roof">
        <pose>0 0 5.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>10.6 7.6 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>10.6 7.6 0.8</size></box></geometry>
          <material><ambient>0.35 0.12 0.10 1</ambient><diffuse>0.52 0.17 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Control tower: tall enough (16m) to reference the 18m ring. -->
    <model name="tower">
      <static>true</static>
      <pose>-19 4 0 0 0 0</pose>
      <link name="shaft">
        <pose>0 0 8 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>1.4</radius><length>16</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>1.4</radius><length>16</length></cylinder></geometry>
          <material><ambient>0.62 0.62 0.60 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse></material>
        </visual>
      </link>
      <link name="cab">
        <pose>0 0 17 0 0 0</pose>
        <collision name="c"><geometry><box><size>4 4 2.4</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>4 4 2.4</size></box></geometry>
          <material><ambient>0.15 0.25 0.35 1</ambient><diffuse>0.22 0.38 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Windsock mast: a visual anchor near the pad for the wind sliders. -->
    <model name="windsock_mast">
      <static>true</static>
      <pose>9 -9 0 0 0 0</pose>
      <link name="mast">
        <pose>0 0 3 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.09</radius><length>6</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.09</radius><length>6</length></cylinder></geometry>
          <material><ambient>0.85 0.45 0.05 1</ambient><diffuse>0.95 0.55 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>
        model://x3_ninjapilot
      </uri>
      <!-- Spawn facing TRUE NORTH (world is ENU: +Y = north, so ENU yaw
           +90deg points body-forward at +Y). Without this the model's
           zero-rotation spawn faces +X = EAST, and the bridge's
           measure-Be-at-spawn convention then defines yaw=0 as east while
           the GPS/NED frame uses true north - a standing ~90deg yaw frame
           error, invisible to attitude leveling and baro-hold but fatal
           to PathFollower (every NED correction rotated ~90deg before
           becoming roll/pitch = lateral spiral divergence, observed
           across three PositionHold gain sets). Facing north makes
           body-frame-at-spawn genuinely equal NED, so the measured-Be
           yaw reference and the GPS frame agree by construction. -->
      <pose>0 0 0.05 0 0 1.5707963</pose>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_0_joint</jointName>
        <linkName>X3/rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>0</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_1_joint</jointName>
        <linkName>X3/rotor_1</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>1</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_2_joint</jointName>
        <linkName>X3/rotor_2</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>2</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin
        filename="gz-sim-multicopter-motor-model-system"
        name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_3_joint</jointName>
        <linkName>X3/rotor_3</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>3</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
    </include>
  </world>
</sdf>
