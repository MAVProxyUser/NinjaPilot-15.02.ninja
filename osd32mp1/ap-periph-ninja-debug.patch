+                auto busdev = hal.i2c_mgr->get_device(0, 0x0d);
+                WITH_SEMAPHORE(busdev->get_semaphore());
+                /* bit-bang with roles swapped: PB14 clocks, PB13 is data */
+                const ioline_t SCLp = PAL_LINE(GPIOB, 14U);   /* normally SDA */
+                const ioline_t SDAp = PAL_LINE(GPIOB, 13U);   /* normally SCL */
+                palSetLineMode(SCLp, PAL_MODE_OUTPUT_OPENDRAIN);
+                palSetLineMode(SDAp, PAL_MODE_OUTPUT_OPENDRAIN);
+                palSetLine(SCLp); palSetLine(SDAp);
+                hal.scheduler->delay_microseconds(50);
+                uint8_t swapped_hits = 0;
