+/* ---- NinjaPilot NAV-SAT streaming capture ----------------------------
+ * UBX-NAV-SAT (0x01 0x35) carries 12 bytes per tracked satellite and can
+ * exceed the parse union with 30+ sats, where the size gate drops the
+ * whole message. So it is parsed as a BYTE STREAM (the same pattern the
+ * CFGv2 VALGET path uses), capped at 16 sats to match the GPSSatellites
+ * UAVObject, and committed only on a valid checksum. The table crosses
+ * to AP_Periph/gps.cpp through a plain global. */
+struct ninja_satinfo_t {
+    volatile uint8_t seq;
+    uint8_t count;
+    uint8_t svid[16];
+    int8_t  elev[16];
+    uint8_t az2[16];    /* azimuth / 2, degrees */
+    uint8_t cno[16];
+};
+ninja_satinfo_t ninja_satinfo;
+static struct {
+    uint8_t numsv;
+    uint8_t count;
+    uint8_t svid[16];
+    int8_t  elev[16];
+    uint8_t az2[16];
+    uint8_t cno[16];
+    int16_t az_lo;
+} ninja_navsat_tmp;
+
+static void ninja_navsat_byte(uint16_t idx, uint8_t b)
+{
+    /* header: iTOW u32, version u8, numSvs u8, rsvd u16; sats at 8,
+     * 12 bytes each: gnssId, svId, cno, elev(i8), azim(i16), prRes(i16),
+     * flags(u32) */
+    if (idx == 5) { ninja_navsat_tmp.numsv = b; ninja_navsat_tmp.count = 0; return; }
+    if (idx < 8) return;
+    uint16_t rel = idx - 8;
+    uint16_t blk = rel / 12;
+    uint16_t off = rel % 12;
+    if (blk >= 16 || blk >= ninja_navsat_tmp.numsv) return;
+    switch (off) {
+    case 1: ninja_navsat_tmp.svid[blk] = b; break;
+    case 2: ninja_navsat_tmp.cno[blk] = b; break;
+    case 3: ninja_navsat_tmp.elev[blk] = (int8_t)b; break;
+    case 4: ninja_navsat_tmp.az_lo = b; break;
+    case 5: {
+        int16_t az = (int16_t)(ninja_navsat_tmp.az_lo | ((uint16_t)b << 8));
+        while (az < 0) az += 360;
+        while (az >= 360) az -= 360;
+        ninja_navsat_tmp.az2[blk] = (uint8_t)(az / 2);
+        if ((uint8_t)(blk + 1) > ninja_navsat_tmp.count) {
+            ninja_navsat_tmp.count = blk + 1;
+        }
+        break;
+    }
+    default: break;
+    }
+}
 #endif
 
 
