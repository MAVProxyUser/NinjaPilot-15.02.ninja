+//   20503  die temperature, raw int16 LE, 1 Hz - degC = raw/340 + 35.
+//          Bytes 6-7 of the same burst read; they were always in hand and
+//          simply never packed. Single frame, so no storm surface.
+// The node does NO calibration, NO filtering, NO unit conversion. DLPF is
+// OFF (256 Hz BW, 8 kHz internal ODR).
+//
+// v3 architecture: sampling runs INSIDE the I2C bus thread via a periodic
+// callback - the per-read cross-thread handoff of v2 measured 2117 us
+// average against 520 us of wire time and capped delivery at ~458 Hz. The
+// callback fills a seqlock-guarded buffer; this thread only consumes the
+// latest sample and broadcasts.
+#define NINJA_MSG_GYRO       20500
+#define NINJA_MSG_IMUTEMP    20503
+#define NINJA_MSG_AKMAG      20504
+#define NINJA_MSG_I2CSCAN    20505
