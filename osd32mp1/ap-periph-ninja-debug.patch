+# hard way: 14 probe bits, two firmware versions, zero probes.
+BARO BMP388 I2C:0:0x77
+BARO BMP388 I2C:0:0x76
+define HAL_PERIPH_NINJA_I2C_DEBUG 1
 
 # ------------------ I2C airspeed -------------------------
-define AP_PERIPH_AIRSPEED_ENABLED 1
+define AP_PERIPH_AIRSPEED_ENABLED 0
 
 # MS4525 sensor by default
 define HAL_AIRSPEED_TYPE_DEFAULT 1
@@ -59,7 +66,7 @@ define HAL_MSP_ENABLED 1
