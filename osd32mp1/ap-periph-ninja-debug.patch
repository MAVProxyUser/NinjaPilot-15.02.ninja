+static void ninja_i2c_scan(void)
+{
+    uint8_t found[16] = {};
+    for (uint8_t a = 0x08; a <= 0x77; a++) {
+        auto dev = hal.i2c_mgr->get_device(0, a, 100000);
+        if (!dev) {
+            continue;
+        }
+        uint8_t v = 0;
+        bool ack;
+        {
+            WITH_SEMAPHORE(dev->get_semaphore());
+            dev->set_retries(1);
+            ack = dev->read_registers(0x00, &v, 1);
+        }
+        if (ack) {
+            found[a >> 3] |= (uint8_t)(1u << (a & 7));
+        }
+    }
+    memcpy(s_i2c_present, found, sizeof(s_i2c_present));
