+        } else if (tx_fail) {
+            imu_last_txfail_ms = now_ms;
+            if (++tx_fail_run >= 50 && !imu_aux_throttle) {
+                imu_hz_degraded = true;    // latched telltale
+                imu_aux_throttle = true;
+                can_printf("DEGRADEDHZ: CAN TX failing - aux capped 5 Hz, IMU kept at full rate");
+            }
+        } else if (tx_fail_run > 0) {
+            tx_fail_run--;
+        }
+        if (imu_aux_throttle && now_ms - imu_last_txfail_ms > 10000) {
+            imu_aux_throttle = false;
+            can_printf("DEGRADEDHZ: TX healthy 10 s - aux streams restored");
+        }
+
+        // pace to the requested rate: sleep only the true remainder,
+        // chunked because delay_microseconds wraps at 65,536 us
+        const uint32_t period_us = 1000000UL / rate;
+        const uint32_t spent_us = AP_HAL::micros() - iter_start_us;
+        if (period_us > spent_us) {
+            uint32_t remain = period_us - spent_us;
+            while (remain > 50000) {
+                hal.scheduler->delay_microseconds(50000);
+                remain -= 50000;
+            }
+            if (remain > 0) {
+                hal.scheduler->delay_microseconds(remain);
+            }
+        }
     }
 }
 #endif // AP_PERIPH_IMU_ENABLED
